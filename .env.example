MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/portfolio"
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: only enable one-time setup and data migration routes locally.
ENABLE_SETUP_ROUTES="false"
SETUP_TOKEN="generate-a-long-random-token"
SETUP_ADMIN_USERNAME="admin"
SETUP_ADMIN_PASSWORD="generate-a-temporary-strong-password"

# Optional: AI content generation in admin.
OPENAI_API_KEY=""

# Optional: contact form notifications.
# Works with Slack, Discord, Make, Zapier, n8n, etc.
CONTACT_WEBHOOK_URL=""
CONTACT_WEBHOOK_FORMAT="generic"

# Optional: Google Search Console HTML meta verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
